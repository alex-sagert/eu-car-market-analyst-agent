# Kopieren nach .env und ausfüllen. .env wird nie hochgeladen (.gitignore).

# --- Datenbank ------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432                 # Laptop mit Docker: 5433
PG_DB=markt_agent
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=           # Passwort des Benutzers postgres (nur für data/load_postgres.py)
PG_AGENT_USER=agent_leser    # wird beim Laden angelegt, darf nur lesen
PG_AGENT_PASSWORD=nur_lesen

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=ollama_cloud    # ollama_cloud | gemini | orakel (Testdouble ohne LLM)
OLLAMA_API_KEY=              # ollama.com -> Settings -> Keys (derselbe wie im Spesen-Agent)
OLLAMA_CLOUD_MODEL=gpt-oss:120b
OLLAMA_LOCAL_MODEL=llama3.2  # für Profil C/D, vorher: ollama pull llama3.2
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_CACHE=1                  # 0 = Cache aus
